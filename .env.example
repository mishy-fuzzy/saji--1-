# Cloudflare R2 example env — DO NOT commit real secrets.
# Copy this to `.env.local` and paste your actual keys.

# Required
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
R2_BUCKET=your_bucket_name_here

# Optional (set if you use a custom endpoint or domain)
# e.g. https://<account>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional public hostname or URL that serves your objects. This can be a domain
# (e.g. cdn.example.com), a full URL (https://cdn.example.com), or include a
# `{bucket}` placeholder (e.g. https://{bucket}.cdn.example.com). Useful for
# developer preview URLs or custom CDN domains. If set, the presign API will
# use this value to construct the public object URL.
R2_PUBLIC_HOSTNAME=
R2_REGION=auto
# App
NEXT_PUBLIC_APP_URL=http://localhost:3500
# For Vercel deployments set NEXT_PUBLIC_APP_URL to your production app URL, e.g. https://your-app.vercel.app
# Runtime connection for the app (Neon pooled URL)
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-POOLER-HOST/neondb?sslmode=require&channel_binding=require"

# Direct connection for Prisma migrate/introspect (Neon non-pooler URL)
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@YOUR-DIRECT-HOST/neondb?sslmode=require&channel_binding=require"

