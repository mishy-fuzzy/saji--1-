generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model PaymentTransaction {
  id         String   @id @default(cuid())
  provider   String
  kind       String
  reference  String?
  externalId String?
  amount     Int?
  currency   String?
  status     String
  request    String?
  response   String?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  bookingId  String?
  booking    Booking? @relation(fields: [bookingId], references: [id])

  @@index([provider, kind])
  @@index([reference])
  @@index([status])
  @@index([createdAt])
}

model User {
  id                     String           @id @default(cuid())
  email                  String           @unique
  passwordHash           String?
  name                   String?
  role                   String           @default("customer")
  image                  String?
  phone                  String?
  isSuspended            Boolean          @default(false)
  deletedAt              DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  emailVerified          Boolean          @default(false)
  lastLoginAt            DateTime?
  adminProfile           Admin?
  agentProfile           Agent?
  bookings               Booking[]        @relation("CustomerBookings")
  jobs                   Booking[]        @relation("ProviderJobs")
  postedJobs             Job[]            @relation("JobPostedBy")
  assignedJobs           Job[]            @relation("JobProvider")
  customerProfile        Customer?
  messages               Message[]
  referralsGot           Referral?        @relation("Referred")
  referralsMade          Referral[]       @relation("Referrer")
  bids                  Bid[]            @relation("ProviderBids")
  secretaryProfile       Secretary?
  services               Service[]        @relation("ProviderServices")
  serviceProviderProfile ServiceProvider?
  wallet                 Wallet?
  verifications          Verification[]   @relation("UserVerifications")
  createdDisputes        Dispute[]        @relation("DisputeCreatedBy")
  assignedDisputes       Dispute[]        @relation("DisputeAssignedTo")

  @@index([role, isSuspended])
}

model Customer {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Agent {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Secretary {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model ServiceProvider {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Admin {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Service {
  id          String    @id @default(cuid())
  name        String
  description String
  category    String
  basePrice   Int
  image       String?
  providerId  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
  jobs        Job[]

model ServiceCategoryMeta {
  id         String   @id @default(cuid())
  name       String   @unique
  type       String?
  iconName   String?
  colorClass String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  @@index([isActive, deletedAt])
}

model LiveSession {
  id          String   @id @default(cuid())
  hostUserId  String
  kind        String
  title       String?
  category    String?
  description String?
  thumbnail   String?
  joinFee     Int?
  viewers     Int      @default(0)
  status      String   @default("live")
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  host        User     @relation(fields: [hostUserId], references: [id])

  @@index([hostUserId])
  @@index([kind, status])
  @@index([status, updatedAt])
}

model ShopOperationalStatus {
  id               String   @id @default(cuid())
  shopkeeperUserId String   @unique
  isOpen           Boolean  @default(false)
  deliveryPercent  Int?
  matchedByAI      Boolean  @default(false)
  statusMessage    String?
  updatedAt        DateTime @updatedAt
  shopkeeper       User     @relation(fields: [shopkeeperUserId], references: [id])

  @@index([isOpen])
}
  provider    User      @relation("ProviderServices", fields: [providerId], references: [id])

  @@index([category])
}

model Job {
  id         String   @id @default(cuid())
  title      String
  description String
  status     String   @default("pending")
  price      Int
  currency   String   @default("KES")
  location   String?
  postedById String
  providerId String?
  serviceId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  postedBy   User     @relation("JobPostedBy", fields: [postedById], references: [id])
  provider   User?    @relation("JobProvider", fields: [providerId], references: [id])
  service    Service? @relation(fields: [serviceId], references: [id])
  disputes   Dispute[]

  @@index([status])
  @@index([postedById])
  @@index([providerId])
  @@index([serviceId])
}

model Booking {
  id                  String               @id @default(cuid())
  status              String               @default("pending")
  amount              Int
  currency            String               @default("KES")
  customerId          String
  providerId          String
  serviceId           String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  customer            User                 @relation("CustomerBookings", fields: [customerId], references: [id])
  provider            User                 @relation("ProviderJobs", fields: [providerId], references: [id])
  service             Service              @relation(fields: [serviceId], references: [id])
  paymentTransactions PaymentTransaction[]
  bids                Bid[]

  @@index([status])
}

model Bid {
  id         String   @id @default(cuid())
  amount     Int
  currency   String   @default("KES")
  note       String?
  status     String   @default("pending") // pending, accepted, rejected
  providerId String
  bookingId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider User    @relation("ProviderBids", fields: [providerId], references: [id])
  booking  Booking @relation(fields: [bookingId], references: [id])

  @@index([providerId])
  @@index([bookingId])
  @@index([status])
}

model Wallet {
  id        String   @id @default(cuid())
  balance   Float    @default(0)
  currency  String   @default("KES")
  userId    String   @unique
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Dispute {
  id          String   @id @default(cuid())
  jobId       String?
  createdById String
  assignedToId String?
  reason      String
  details     String?
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job         Job?     @relation(fields: [jobId], references: [id])
  createdBy   User     @relation("DisputeCreatedBy", fields: [createdById], references: [id])
  assignedTo  User?    @relation("DisputeAssignedTo", fields: [assignedToId], references: [id])

  @@index([status])
  @@index([createdById])
  @@index([assignedToId])
  @@index([jobId])
}

model Verification {
  id         String   @id @default(cuid())
  userId     String
  documentUrl String?
  notes      String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation("UserVerifications", fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
}

model Message {
  id         String   @id @default(cuid())
  text       String
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())
  sender     User     @relation(fields: [senderId], references: [id])

  @@index([senderId])
  @@index([receiverId])
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  referredId String   @unique
  status     String   @default("pending")
  reward     Float?
  createdAt  DateTime @default(now())
  referred   User     @relation("Referred", fields: [referredId], references: [id])
  referrer   User     @relation("Referrer", fields: [referrerId], references: [id])
}

model NotificationLog {
  id        String   @id @default(cuid())
  provider  String
  channel   String
  recipient String
  message   String
  status    String
  response  String?
  error     String?
  createdAt DateTime @default(now())

  @@index([provider, channel])
  @@index([status])
  @@index([createdAt])
}

model AuthLog {
  id        String   @id @default(cuid())
  provider  String
  mode      String
  email     String?
  status    String
  response  String?
  error     String?
  createdAt DateTime @default(now())

  @@index([provider, mode])
  @@index([status])
  @@index([createdAt])
}

model ShopkeeperPromotion {
  id          String   @id @default(cuid())
  ownerUserId String
  ownerEmail  String?
  name        String
  code        String
  type        String
  value       Float
  minOrder    Float    @default(0)
  maxUses     Int      @default(0)
  usedCount   Int      @default(0)
  startDate   DateTime
  endDate     DateTime
  status      String
  products    String   @default("")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([ownerUserId, deletedAt])
  @@index([ownerEmail, deletedAt])
  @@index([status])
}

model ShopkeeperReview {
  id              String   @id @default(cuid())
  shopkeeperUserId String
  customerUserId  String?
  customerName    String
  customerAvatar  String   @default("/placeholder.svg")
  productName     String   @default("Service")
  rating          Int      @default(0)
  text            String   @default("")
  helpful         Int      @default(0)
  replied         Boolean  @default(false)
  reply           String   @default("")
  replyDate       DateTime?
  reported        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([shopkeeperUserId, deletedAt])
  @@index([customerUserId])
  @@index([rating])
}

model VirtualGift {
  id        String   @id @default(cuid())
  name      String   @unique
  icon      String   @default("🎁")
  price     Int
  description String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([price])
  @@index([isActive])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}
